{
  "name": "devtracker-server",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch knexfile.js --ext js src/index.js",
    "start": "node src/index.js",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "seed": "knex --knexfile knexfile.js seed:run",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "knex": "^3.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
}
